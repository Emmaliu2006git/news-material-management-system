# Demo placeholders only. Replace every secret before any shared deployment.
# Compose service credentials and browser CORS.
POSTGRES_PASSWORD=replace-me-postgres
MINIO_ROOT_USER=replace-me-minio-user
MINIO_ROOT_PASSWORD=replace-me-minio-password
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:8080

# Application overrides forwarded by docker-compose.yml.
SERVER_PORT=8080
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/news_material
SPRING_DATASOURCE_USERNAME=news_material
NEWS_MATERIAL_S3_BUCKET=news-material-private
AWS_REGION=us-east-1
NEWS_MATERIAL_S3_ENDPOINT=http://minio:9000
NEWS_MATERIAL_S3_PRESIGNER_ENDPOINT=http://localhost:9000
NEWS_MATERIAL_S3_PATH_STYLE=true
NEWS_MATERIAL_AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_CONNECT_TIMEOUT=PT3S
OPENAI_REQUEST_TIMEOUT=PT20S
ANALYSIS_LEASE_DURATION=PT5M
APP_ANALYSIS_SCHEDULING_ENABLED=true
APP_ANALYSIS_MAX_ATTEMPTS=3
APP_ANALYSIS_BASE_BACKOFF=PT1M
APP_ANALYSIS_POLL_DELAY_MS=5000
APP_UPLOAD_MAX_FILES=10
APP_UPLOAD_MAX_FILE_BYTES=52428800
APP_UPLOAD_MAX_TOTAL_BYTES=209715200
APP_UPLOAD_INTENT_TTL=PT15M
